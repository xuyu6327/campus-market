/* ============================================================
   校园二手交易平台 - 全局设计系统（rpx 适配，参考 Web 版 common.css）
   设计规范：主色 #FF6B35、辅色 #2EC4B6、背景 #FFF9F5
   ============================================================ */
page {
  /* Design Tokens */
  --color-primary: #FF6B35;
  --color-primary-hover: #E55A2B;
  --color-primary-light: #FFF0EB;
  --color-secondary: #2EC4B6;
  --color-secondary-light: #E0F7F5;
  --color-accent: #FFD23F;
  --color-star: #FFB627;
  --color-bg: #FFF9F5;
  --color-surface: #FFFFFF;
  --color-surface-alt: #FAF6F2;
  --color-border: #F0E6E0;
  --color-border-strong: #D4C9C0;
  --color-text-primary: #1A1A2E;
  --color-text-secondary: #6B7280;
  --color-text-tertiary: #9CA3AF;
  --color-success: #10B981;
  --color-success-light: #D1FAE5;
  --color-warning: #F59E0B;
  --color-warning-light: #FEF3C7;
  --color-danger: #EF4444;
  --color-danger-light: #FEE2E2;
  --color-info: #3B82F6;
  --color-info-light: #DBEAFE;

  background: var(--color-bg);
  color: var(--color-text-primary);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ---------- 通用工具类 ---------- */
.page { padding-bottom: 40rpx; min-height: 100vh; }
.card {
  background: var(--color-surface);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 46, 0.04);
}
.text-ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.text-clamp-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.flex { display: flex; align-items: center; }
.flex-1 { flex: 1; min-width: 0; }

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 32rpx;
  height: 76rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  line-height: 1;
}
.btn::after { border: none; }
.btn-primary { background: var(--color-primary); color: #fff; }
.btn-primary.disabled { background: var(--color-border); color: var(--color-text-tertiary); }
.btn-outline { background: var(--color-surface); color: var(--color-primary); border-color: var(--color-primary); }
.btn-ghost { background: var(--color-surface-alt); color: var(--color-text-secondary); }
.btn-danger { background: var(--color-danger); color: #fff; }
.btn-block { width: 100%; }
.btn-sm { height: 56rpx; font-size: 24rpx; padding: 0 22rpx; border-radius: 12rpx; }

/* ---------- 状态标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}
.tag-success { background: var(--color-success-light); color: var(--color-success); }
.tag-warning { background: var(--color-warning-light); color: var(--color-warning); }
.tag-danger { background: var(--color-danger-light); color: var(--color-danger); }
.tag-info { background: var(--color-info-light); color: var(--color-info); }
.tag-gray { background: var(--color-surface-alt); color: var(--color-text-tertiary); }

/* ---------- 空状态 ---------- */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}
.empty-state .empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-surface-alt);
  color: var(--color-text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin: 0 auto 20rpx;
  font-style: normal;
}
.empty-state .sub { font-size: 22rpx; color: var(--color-text-tertiary); margin-top: 8rpx; }

/* ---------- 加载更多 ---------- */
.load-more {
  text-align: center;
  padding: 30rpx 0 60rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ---------- 表单 ---------- */
.form-group { margin-bottom: 24rpx; }
.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}
.form-label .required { color: var(--color-danger); }
.form-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border: 3rpx solid var(--color-border);
  border-radius: 14rpx;
  background: var(--color-surface);
  font-size: 28rpx;
  box-sizing: border-box;
}
.form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 3rpx solid var(--color-border);
  border-radius: 14rpx;
  background: var(--color-surface);
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 160rpx;
}
.form-hint { font-size: 22rpx; color: var(--color-text-tertiary); margin-top: 8rpx; }

/* ---------- 弹窗 ---------- */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-sheet {
  width: 100%;
  background: var(--color-surface);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  animation: mp-slide-up 0.25s ease;
  max-height: 80vh;
  overflow-y: auto;
  box-sizing: border-box;
}
.modal-sheet.center {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 85%;
  border-radius: 24rpx;
  margin-bottom: 30vh;
}
@keyframes mp-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.modal-close {
  width: 56rpx; height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  font-size: 36rpx;
}

/* ---------- 底部操作栏 ---------- */
.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--color-surface);
  border-top: 2rpx solid var(--color-border);
  z-index: 100;
}

/* ---------- 分割线 ---------- */
.divider { height: 2rpx; background: var(--color-border); }
