/* 我的订单 */
.orders-page { padding-bottom: 40rpx; }
.order-tabs { display: flex; background: #fff; border-bottom: 2rpx solid var(--color-border); }
.order-tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-weight: 600;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  position: relative;
}
.order-tab.active { color: var(--color-primary); }
.order-tab.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 6rpx;
}

.order-search {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--color-border);
  align-items: center;
}
.search-input {
  flex: 1;
  height: 68rpx;
  background: var(--color-surface-alt);
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}
.search-btn {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  border-radius: 14rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.order-filter {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--color-border);
  white-space: nowrap;
}
.filter-item {
  flex-shrink: 0;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  border: 3rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.filter-item.active { border-color: var(--color-primary); background: var(--color-primary-light); color: var(--color-primary); font-weight: 600; }

.order-list { padding: 20rpx 24rpx; }
.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 46, 0.04);
}
.order-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-bottom: 2rpx solid var(--color-border);
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.order-card-body { display: flex; gap: 20rpx; padding: 20rpx 28rpx; }
.order-card-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 10rpx;
  background: var(--color-surface-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.order-card-img image { width: 100%; height: 100%; }
.img-ph { font-size: 48rpx; opacity: 0.25; }
.order-card-title { font-weight: 600; font-size: 26rpx; }
.order-card-price { font-size: 30rpx; font-weight: 700; color: var(--color-primary); margin-top: 6rpx; }
.order-card-other { font-size: 22rpx; color: var(--color-text-tertiary); margin-top: 6rpx; }
