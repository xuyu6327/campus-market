/* 聊天窗口 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.chat-body {
  flex: 1;
  padding: 24rpx 24rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.msg-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; align-items: flex-end; }
.msg-row.mine { flex-direction: row-reverse; }
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
}
.msg-avatar image { width: 100%; height: 100%; }
.msg-wrap { max-width: 70%; display: flex; flex-direction: column; }
.msg-bubble {
  padding: 18rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}
.msg-row.them .msg-bubble { background: #fff; border-top-left-radius: 8rpx; box-shadow: 0 2rpx 8rpx rgba(26, 26, 46, 0.04); }
.msg-row.mine .msg-bubble { background: var(--color-primary); color: #fff; border-top-right-radius: 8rpx; }
.msg-time { font-size: 20rpx; color: var(--color-text-tertiary); margin-top: 8rpx; }
.msg-row.mine .msg-time { text-align: right; }

.chat-input-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: #fff;
  border-top: 2rpx solid var(--color-border);
  flex-shrink: 0;
  align-items: center;
}
.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  border: 3rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-bg);
  font-size: 28rpx;
}
.send-btn {
  flex-shrink: 0;
  padding: 0 36rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
