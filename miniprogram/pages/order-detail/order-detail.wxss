/* 订单详情 */
.od-page { padding-bottom: 160rpx; }

.od-status {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  background: #fff;
  margin-bottom: 16rpx;
}
.od-status-icon { font-size: 56rpx; }
.od-status-title { font-size: 36rpx; font-weight: 700; }
.od-status-peer { font-size: 24rpx; color: var(--color-text-tertiary); margin-top: 4rpx; }

.frozen-tip {
  background: var(--color-danger-light);
  color: var(--color-danger);
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.od-section {
  background: #fff;
  margin-bottom: 16rpx;
  padding: 28rpx 32rpx;
}
.od-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}
.goods-section { display: flex; gap: 20rpx; align-items: center; }
.od-goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: var(--color-surface-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.od-goods-img image { width: 100%; height: 100%; }
.img-ph { font-size: 44rpx; opacity: 0.25; }
.od-goods-title { font-weight: 600; font-size: 28rpx; }
.od-goods-price { font-size: 32rpx; font-weight: 700; color: var(--color-primary); margin-top: 6rpx; }

.od-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--color-border);
  font-size: 26rpx;
}
.od-row:last-child { border-bottom: none; }
.od-label { color: var(--color-text-tertiary); }
.od-value { font-weight: 600; word-break: break-all; text-align: right; margin-left: 24rpx; }
.od-hint { font-size: 22rpx; color: var(--color-text-tertiary); padding-top: 12rpx; }

/* 底部操作 */
.bottom-bar .action-btn { flex: 1; }
.rated-btn { opacity: 0.6; }

/* 评价 */
.review-tip { text-align: center; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 16rpx; }
.review-stars { display: flex; justify-content: center; gap: 16rpx; margin-bottom: 24rpx; }
.review-star { font-size: 60rpx; color: var(--color-border-strong); }
.review-star.active { color: var(--color-star); }
.review-anon {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 16rpx;
}
.anon-box {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid var(--color-border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: transparent;
}
.anon-box.checked { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
