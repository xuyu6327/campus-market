/* 发布商品 */
.publish-page { padding-bottom: 300rpx; }
.form-section {
  background: #fff;
  margin-bottom: 16rpx;
  padding: 28rpx 32rpx;
}
.form-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
}
.form-section-title .required { color: var(--color-danger); }
.form-hint-inline { font-weight: 400; font-size: 22rpx; color: var(--color-text-tertiary); }

.picker-box {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  border: 3rpx solid var(--color-border);
  border-radius: 14rpx;
  background: #fff;
  font-size: 28rpx;
}
.picker-box.placeholder { color: var(--color-text-tertiary); }

.price-row { display: flex; gap: 20rpx; }
.price-col { flex: 1; }

.image-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.image-item {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  overflow: hidden;
  position: relative;
}
.image-item image { width: 100%; height: 100%; }
.image-remove {
  position: absolute;
  top: 6rpx; right: 6rpx;
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.upload-box {
  width: 150rpx;
  height: 150rpx;
  border: 4rpx dashed var(--color-border);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  box-sizing: border-box;
}
.upload-icon { font-size: 48rpx; line-height: 1.2; }
.upload-count { font-size: 20rpx; }

.contact-methods { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.contact-method {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  border: 3rpx solid var(--color-border);
  border-radius: 14rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.contact-method.active {
  border-color: var(--color-secondary);
  background: var(--color-secondary-light);
  color: var(--color-secondary);
  font-weight: 600;
}

.submit-bar {
  position: fixed;
  left: 0; right: 0; bottom: 120rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: #fff;
  border-top: 2rpx solid var(--color-border);
  z-index: 100;
}
.submit-bar .btn { height: 88rpx; }
