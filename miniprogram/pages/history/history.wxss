/* 浏览记录 */
.history-page { padding-bottom: 40rpx; }
.goods-list { padding: 20rpx 24rpx; }
.goods-card {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 46, 0.04);
}
.goods-card-img {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: var(--color-surface-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.goods-card-img image { width: 100%; height: 100%; }
.img-ph { font-size: 64rpx; opacity: 0.25; }
.goods-card-body { padding: 20rpx 20rpx 20rpx 0; }
.goods-card-title { font-weight: 600; font-size: 26rpx; line-height: 1.4; }
.goods-card-price { font-size: 32rpx; font-weight: 700; color: var(--color-primary); margin-top: 6rpx; }
.goods-card-meta { display: flex; gap: 16rpx; font-size: 22rpx; color: var(--color-text-tertiary); margin-top: 6rpx; }
