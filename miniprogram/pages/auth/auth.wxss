/* 登录注册 */
.auth-page { padding: 80rpx 56rpx 0; min-height: 100vh; box-sizing: border-box; }
.auth-logo { text-align: center; font-size: 56rpx; font-weight: 800; }
.logo-accent { color: var(--color-primary); }
.auth-slogan { text-align: center; font-size: 24rpx; color: var(--color-text-tertiary); margin-top: 12rpx; margin-bottom: 60rpx; }

.auth-tabs {
  display: flex;
  margin-bottom: 40rpx;
  border-bottom: 2rpx solid var(--color-border);
}
.auth-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-tertiary);
  position: relative;
}
.auth-tab.active { color: var(--color-primary); }
.auth-tab.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 6rpx;
}

.auth-form .form-group { margin-bottom: 28rpx; }
.auth-form .btn { height: 88rpx; margin-top: 16rpx; }
.auth-tip { font-size: 22rpx; color: var(--color-text-tertiary); text-align: center; margin-top: 24rpx; }
