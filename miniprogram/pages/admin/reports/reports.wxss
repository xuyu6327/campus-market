/* 举报管理 */
@import "../common.wxss";

.report-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.05);
}
.report-top { display: flex; align-items: center; justify-content: space-between; }
.report-time { font-size: 22rpx; color: var(--color-text-tertiary); }
.report-title { font-size: 28rpx; font-weight: 700; margin-top: 12rpx; }
.report-type { font-size: 22rpx; color: var(--color-text-tertiary); font-weight: 400; }
.report-reason { font-size: 24rpx; color: var(--color-text-secondary); margin-top: 8rpx; }
.report-reporter { font-size: 22rpx; color: var(--color-text-tertiary); margin-top: 8rpx; }

.checkbox-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin: 8rpx 0 20rpx;
}
.anon-box {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: transparent;
}
.anon-box.checked { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
