/* pages/admin/common.wxss - 管理端公共样式（浅色卡片现代风）
   各管理页 @import "common.wxss" 复用 */
.admin-page { padding: 24rpx 24rpx 60rpx; min-height: 100vh; box-sizing: border-box; }

/* 顶部渐变标题栏 */
.admin-hero {
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 53, 0.25);
}
.admin-hero .hero-title { font-size: 38rpx; font-weight: 800; }
.admin-hero .hero-sub { font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }

/* 搜索栏 */
.admin-search {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 20rpx;
}
.admin-search-input {
  flex: 1;
  height: 76rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 46, 0.05);
}
.admin-search-btn {
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

/* 筛选 chips */
.admin-chips {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}
.admin-chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.admin-chip.active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: 600;
}

/* 统计卡片（入口页） */
.stat-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.stat-card {
  width: 330rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.05);
  box-sizing: border-box;
}
.stat-card .stat-value { font-size: 44rpx; font-weight: 800; color: var(--color-text-primary); line-height: 1.2; }
.stat-card .stat-label { font-size: 22rpx; color: var(--color-text-tertiary); margin-top: 6rpx; }
.stat-card .stat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 16rpx;
}
.stat-icon.orange { background: var(--color-primary-light); }
.stat-icon.green { background: var(--color-secondary-light); }
.stat-icon.blue { background: var(--color-info-light); }
.stat-icon.red { background: var(--color-danger-light); }
.stat-icon.yellow { background: var(--color-warning-light); }
.stat-icon.purple { background: #F3E8FF; }

/* 功能宫格 */
.grid-6 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 20rpx 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.05);
}
.grid-item {
  width: 33.3%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}
.grid-item .grid-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 12rpx;
}
.grid-item .grid-text { font-size: 24rpx; font-weight: 600; color: var(--color-text-primary); }

/* 列表卡片 */
.admin-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.05);
}
.admin-card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }

/* 信息行（详情/列表） */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--color-border);
  font-size: 26rpx;
  gap: 24rpx;
}
.info-row:last-child { border-bottom: none; }
.info-label { color: var(--color-text-tertiary); flex-shrink: 0; }
.info-value { font-weight: 600; text-align: right; word-break: break-all; flex: 1; }
.info-value.muted { color: var(--color-text-secondary); font-weight: 400; }

/* 状态标签 */
.tag { display: inline-flex; align-items: center; padding: 4rpx 16rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 700; }
.tag-success { background: #D1FAE5; color: #10B981; }
.tag-warning { background: #FEF3C7; color: #F59E0B; }
.tag-danger { background: #FEE2E2; color: #EF4444; }
.tag-info { background: #DBEAFE; color: #3B82F6; }
.tag-gray { background: #FAF6F2; color: #9CA3AF; }

/* 操作按钮组 */
.action-row { display: flex; gap: 16rpx; margin-top: 20rpx; flex-wrap: wrap; }
.action-btn {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid var(--color-border-strong);
  color: var(--color-text-secondary);
  background: #fff;
}
.action-btn.primary { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
.action-btn.danger { color: #EF4444; border-color: #FECACA; }
.action-btn.success { color: #10B981; border-color: #A7F3D0; }
.action-btn.disabled { opacity: 0.45; }

/* 弹窗（底部 sheet） */
.sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  max-height: 80vh;
  overflow-y: auto;
  box-sizing: border-box;
}
.sheet-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; display: flex; justify-content: space-between; align-items: center; }
.sheet-close { color: var(--color-text-tertiary); font-size: 40rpx; padding: 0 8rpx; }

/* 表单（弹窗内） */
.admin-form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.admin-form-textarea {
  width: 100%;
  min-height: 140rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.admin-form-label { font-size: 24rpx; font-weight: 600; color: var(--color-text-secondary); margin: 8rpx 0 12rpx; display: block; }

/* 单选卡（举报处理等） */
.radio-card {
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.radio-card.active { border-color: var(--color-primary); background: var(--color-primary-light); color: var(--color-primary); font-weight: 600; }
.radio-card .desc { font-size: 20rpx; color: var(--color-text-tertiary); font-weight: 400; }

/* 图片缩略 */
.thumb-grid { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 12rpx; }
.thumb-grid image { width: 110rpx; height: 110rpx; border-radius: 12rpx; }

/* 空态 */
.empty { padding: 100rpx 0; text-align: center; color: var(--color-text-tertiary); font-size: 26rpx; }

/* 加载更多 */
.load-more { text-align: center; padding: 24rpx 0 40rpx; font-size: 24rpx; color: var(--color-text-tertiary); }
