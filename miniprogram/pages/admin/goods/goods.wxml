<!-- 商品管理 -->
<view class="admin-page">
  <!-- 搜索 -->
  <view class="admin-search">
    <input class="admin-search-input" placeholder="搜索商品标题" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="onSearch" />
    <view class="admin-search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 状态筛选 -->
  <view class="admin-chips">
    <view class="admin-chip {{status === '' ? 'active' : ''}}" data-status="" bindtap="onStatus">全部</view>
    <view class="admin-chip {{status === '1' ? 'active' : ''}}" data-status="1" bindtap="onStatus">在售</view>
    <view class="admin-chip {{status === '2' ? 'active' : ''}}" data-status="2" bindtap="onStatus">已预订</view>
    <view class="admin-chip {{status === '3' ? 'active' : ''}}" data-status="3" bindtap="onStatus">已售出</view>
    <view class="admin-chip {{status === '4' ? 'active' : ''}}" data-status="4" bindtap="onStatus">待审核</view>
    <view class="admin-chip {{status === '0' ? 'active' : ''}}" data-status="0" bindtap="onStatus">已下架</view>
  </view>

  <!-- 列表 -->
  <view class="goods-card" wx:for="{{goods}}" wx:key="id" data-id="{{item.id}}" bindtap="showDetail">
    <view class="goods-img">
      <image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" />
      <view wx:else class="img-ph">📦</view>
    </view>
    <view class="goods-body flex-1">
      <view class="goods-title text-ellipsis">{{item.title}}</view>
      <view class="goods-price">¥{{item.priceText}} <text class="tag {{item.statusClass}}">{{item.statusDesc}}</text></view>
      <view class="goods-sub">{{item.sellerNickname || '未知卖家'}} · {{item.viewCount}}浏览</view>
      <view class="goods-sub" wx:if="{{item.takedownBy === 1}}">强制下架：{{item.takedownReason || '未填写'}}</view>
    </view>
  </view>

  <view wx:if="{{!loading && goods.length === 0}}" class="empty">暂无商品</view>
  <view class="load-more" wx:if="{{goods.length > 0}}">{{loadMoreText}}</view>

  <!-- 详情弹窗 -->
  <view class="sheet-mask" wx:if="{{showDetailModal}}" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">
        <text>商品详情</text>
        <text class="sheet-close" bindtap="closeDetail">×</text>
      </view>
      <view class="thumb-grid">
        <image wx:for="{{detail.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
      </view>
      <view class="info-row"><text class="info-label">标题</text><text class="info-value">{{detail.title}}</text></view>
      <view class="info-row"><text class="info-label">价格</text><text class="info-value">¥{{detail.priceText}}<text wx:if="{{detail.originalPrice > 0}}">（原价 ¥{{detail.originalPriceText}}）</text></text></view>
      <view class="info-row"><text class="info-label">分类</text><text class="info-value">{{detail.categoryName || '-'}}</text></view>
      <view class="info-row"><text class="info-label">成色</text><text class="info-value">{{detail.conditionDesc || detail.goodsCondition}}</text></view>
      <view class="info-row"><text class="info-label">卖家</text><text class="info-value">{{detail.sellerNickname}}</text></view>
      <view class="info-row"><text class="info-label">状态</text><text class="info-value">{{detail.statusDesc}}</text></view>
      <view class="info-row"><text class="info-label">交易地点</text><text class="info-value">{{detail.tradeLocation || '-'}}</text></view>
      <view class="info-row"><text class="info-label">卖家手机</text><text class="info-value">{{detail.contactPhone || '-'}}</text></view>
      <view class="info-row"><text class="info-label">卖家QQ</text><text class="info-value">{{detail.contactQq || '-'}}</text></view>
      <view class="info-row"><text class="info-label">卖家微信</text><text class="info-value">{{detail.contactWechat || '-'}}</text></view>
      <view class="info-row"><text class="info-label">浏览量/收藏</text><text class="info-value">{{detail.viewCount}} / {{detail.favoriteCount}}</text></view>
      <view class="info-row"><text class="info-label">发布时间</text><text class="info-value">{{detail.createTimeText}}</text></view>
      <view class="info-row" wx:if="{{detail.description}}"><text class="info-label">描述</text><text class="info-value muted">{{detail.description}}</text></view>

      <!-- 操作：强制下架 / 审核 -->
      <view class="action-row">
        <view wx:if="{{detail.status === 1 || detail.status === 2 || detail.status === 3}}" class="action-btn danger" bindtap="openTakedown">强制下架</view>
        <view wx:if="{{detail.status === 4}}" class="action-btn success" bindtap="openReview">审核上架</view>
      </view>
    </view>
  </view>

  <!-- 强制下架弹窗 -->
  <view class="sheet-mask" wx:if="{{showTakedown}}" bindtap="closeTakedown">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">
        <text>强制下架商品</text>
        <text class="sheet-close" bindtap="closeTakedown">×</text>
      </view>
      <view class="admin-form-label">下架原因（必填，卖家可见）</view>
      <textarea class="admin-form-textarea" placeholder="请填写下架原因" value="{{takedownReason}}" bindinput="onTakedownReason" />
      <button class="btn btn-danger btn-block" bindtap="submitTakedown">确认强制下架</button>
    </view>
  </view>

  <!-- 审核弹窗 -->
  <view class="sheet-mask" wx:if="{{showReview}}" bindtap="closeReview">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">
        <text>审核重新上架</text>
        <text class="sheet-close" bindtap="closeReview">×</text>
      </view>
      <view class="admin-form-label">审核意见（驳回时必填）</view>
      <textarea class="admin-form-textarea" placeholder="驳回原因或审核备注" value="{{reviewReason}}" bindinput="onReviewReason" />
      <view class="action-row" style="margin-top: 8rpx;">
        <view class="action-btn danger" bindtap="reviewReject">驳回</view>
        <view class="action-btn primary" bindtap="reviewApprove">通过</view>
      </view>
    </view>
  </view>
</view>
